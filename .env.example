# Copy to .env for local development. On Render, set these in the service's Environment tab.

# Either a full connection string (Neon/Render/Supabase)...
DATABASE_URL=
# ...or individual settings for a local Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=APWTDB
# Set to true for hosted databases that require SSL (Neon does)
DB_SSL=false

PORT=3001
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000
# Any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Demo accounts (one per role) created on startup so visitors can sign in.
# DEMO_EMAIL is the master admin, the only account that can manage other admins.
DEMO_EMAIL=demo@abroadstudy.com
DEMO_MANAGER_EMAIL=manager.demo@abroadstudy.com
DEMO_CONSULTANT_EMAIL=consultant.demo@abroadstudy.com
DEMO_USER_EMAIL=user.demo@abroadstudy.com
DEMO_PASSWORD=Demo@1234

# Leave SMTP_HOST empty to only simulate emails (recommended for the public demo)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
